# EXAMPLE ONLY. All credentials below are fake; do not use this as runtime config.
# node tools/cloud/environment.mjs creates ignored .env.cloud.local with random
# development secrets and absolute checkout-local state path. No shell sourcing.
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
PAPERMARK_CLOUD_SYNTHETIC_ONLY=true
PAPERMARK_CLOUD_DB_PASSWORD=FAKE_DEVELOPMENT_DATABASE_PASSWORD
PAPERMARK_CLOUD_REDIS_PASSWORD=FAKE_DEVELOPMENT_REDIS_PASSWORD
POSTGRES_PRISMA_URL=postgresql://papermark_cloud:FAKE_DEVELOPMENT_DATABASE_PASSWORD@127.0.0.1:15432/papermark_cloud?schema=public
POSTGRES_PRISMA_URL_NON_POOLING=postgresql://papermark_cloud:FAKE_DEVELOPMENT_DATABASE_PASSWORD@127.0.0.1:15432/papermark_cloud?schema=public
POSTGRES_PRISMA_SHADOW_URL=postgresql://papermark_cloud:FAKE_DEVELOPMENT_DATABASE_PASSWORD@127.0.0.1:15432/papermark_cloud_shadow?schema=public
NEXTAUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
PAPERMARK_ALLOWED_ORIGINS=http://127.0.0.1:3000
NEXTAUTH_SECRET=FAKE_DEVELOPMENT_AUTH_SECRET
PAPERMARK_MEDIA_SECRET=FAKE_DEVELOPMENT_MEDIA_SECRET
PAPERMARK_OWNER_ID=cloud-synthetic-owner
PAPERMARK_TEAM_ID=cloud-synthetic-team
PAPERMARK_OWNER_PASSWORD_HASH=
PAPERMARK_PUBLIC_SHARING_ENABLED=false
PAPERMARK_STATE_DIR=/ABSOLUTE/CHECKOUT/.cloud/state
UPSTASH_REDIS_REST_URL=http://127.0.0.1:18080
UPSTASH_REDIS_REST_TOKEN=FAKE_DEVELOPMENT_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_LOCKER_URL=http://127.0.0.1:18080
UPSTASH_REDIS_REST_LOCKER_TOKEN=FAKE_DEVELOPMENT_REDIS_REST_TOKEN
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_ENDPOINT=http://127.0.0.1:18333
NEXT_PRIVATE_UPLOAD_REGION=us-east-1
NEXT_PRIVATE_UPLOAD_BUCKET=papermark-cloud-synthetic
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=FAKE_DEVELOPMENT_S3_KEY
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=FAKE_DEVELOPMENT_S3_SECRET
